[Desktop Entry]
Version=1.0
Type=Application
Name=DroidPad
GenericName=Android Keyboard & Gamepad Bridge
Comment=Use your Android phone as a keyboard and Xbox gamepad on Linux
Exec=droidpad-daemon
Icon=droidpad
StartupNotify=true
StartupWMClass=com.droidpad.LinuxDaemon
Terminal=false
Categories=Utility;Settings;HardwareSettings;
Keywords=gamepad;keyboard;android;bluetooth;controller;remote;
Actions=NoTray;

[Desktop Action NoTray]
Name=Start Headless (No Window)
Exec=droidpad-daemon --no-tray
